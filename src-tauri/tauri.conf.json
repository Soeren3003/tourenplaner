{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tourenplaner",
  "version": "1.4.1",
  "identifier": "de.soeren3003.tourenplaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tourenplaner",
        "width": 1440,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 640,
        "dragDropEnabled": true,
        "userAgent": "Tourenplaner (Motorradtouren-Planer; Tauri)"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https://tile.openstreetmap.org https://*.tile.opentopomap.org",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Travel",
    "copyright": "© 2026 Soeren3003, MIT-Lizenz",
    "shortDescription": "Planung, Routen und Kosten für Motorradtouren",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
