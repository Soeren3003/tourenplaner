{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tourenplaner",
  "version": "1.2.1",
  "identifier": "de.soeren3003.tourenplaner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tourenplaner",
        "width": 1440,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 640,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Travel",
    "copyright": "© 2026 Soeren3003, MIT-Lizenz",
    "shortDescription": "Planung, Routen und Kosten für Motorradtouren",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
